		"@types/better-sqlite3": "^9.6.0",
		"@types/sortablejs": "^1.15.9",
		"@vite-pwa/sveltekit": "^1.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@lucide/svelte": "^1.41.0",
		"@node-rs/argon2": "^2.2.0",
		"better-sqlite3": "^13.0.3",
		"dexie": "^4.4.5",
