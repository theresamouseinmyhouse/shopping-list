# Everything here is OPTIONAL. Copy to list.env only if you want to set something;
# `docker compose` picks the file up automatically. Read once at container start.

# Shared household password.
#  - unset  -> the first person to open the app picks it ("create a password" screen)
#  - set    -> pre-seeds it; change it later by editing this + restarting
# LIST_PASSWORD=change-me

# Signs the session cookie. If unset, a random secret is generated and stored in
# the DB (sessions still survive restarts). Set it explicitly only if you want it
# reproducible / captured in your backups. 64+ random chars.
# LIST_SECRET=

# Bearer token for POST /api/quick-add (voice assistants, scripts). If unset, that
# endpoint only accepts a logged-in session.
# LIST_API_TOKEN=

# Rarely needed.
# BODY_SIZE_LIMIT=1M
# ORIGIN=https://list.example.com   # pin only if adapter-node's origin detection misfires
# LIST_DB_PATH=/data/list.db        # default; the volume provides /data
