# Everything here is OPTIONAL. Copy to list.env only if you want to set something;
# `docker compose` picks the file up automatically. Read once at container start.

# Shared household password. Only used to seed a FRESH install:
#  - unset  -> the first person to open the app picks it ("create a password" screen)
#  - set    -> pre-seeds it
# Once a password exists (either way), this is ignored — change the password from
# Settings in the app instead. Editing this + restarting no longer rotates it.
# LIST_PASSWORD=change-me

# Signs the session cookie. If unset, a random secret is generated and stored in
# the DB (sessions still survive restarts). Set it explicitly only if you want it
# reproducible / captured in your backups. 64+ random chars.
# LIST_SECRET=

# Bearer token for POST /api/quick-add (voice assistants, scripts). If unset, that
# endpoint only accepts a logged-in session.
# LIST_API_TOKEN=

# Gemini API key for Recipes -> Import (photo of a page, a link with no structured
# data, or "Make one up" from a description) and "Tidy with AI". Links that carry
# schema.org recipe data import without it. Only seeds a FRESH install — once AI
# has been configured (here or in Settings), this is ignored; manage the key,
# model, on/off toggle, and extra instructions from Settings in the app instead.
# LIST_GEMINI_API_KEY=
# LIST_GEMINI_MODEL=gemini-2.5-flash

# Extra allowed origins for form submissions, comma-separated. Only needed if a
# reverse proxy in front of the app rewrites the Host header to something internal
# (most — nginx `$host`, Caddy, Cloudflare Tunnel — forward the original Host and
# need nothing here). e.g. LIST_TRUSTED_ORIGINS=https://list.example.com
# LIST_TRUSTED_ORIGINS=

# Rarely needed.
# adapter-node caps request bodies at 512K — raise it for "Recipes → Import from a photo"
# (phone photos are several MB). Safe to leave at 12M.
BODY_SIZE_LIMIT=12M
# ORIGIN=https://list.example.com   # pin only if adapter-node's origin detection misfires
# LIST_DB_PATH=/data/list.db        # default; the volume provides /data
