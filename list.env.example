# Copy to list.env (gitignored) and fill in. Read at container start.

# The shared household password. OPTIONAL:
#  - leave it unset and the first person to open the app picks the password
#    on a one-time "create a password" screen.
#  - set it to pre-seed the password, or to rotate it later (on boot the app
#    re-hashes it if it changed, then otherwise ignores it).
# LIST_PASSWORD=change-me

# Signs the session cookie. 64+ random chars. If unset, a random one is generated
# and persisted in the DB (sessions still survive restarts, but set it explicitly
# so it's reproducible / backed up).
LIST_SECRET=

# Public origin, scheme included. Optional — only set it if adapter-node's
# redirect/CSRF origin detection needs pinning. Leave unset when the app is
# reached over both plain-http LAN and an HTTPS proxy (setting it forces the
# cookie Secure flag and can break the http path).
# ORIGIN=https://list.example.com

# Long-lived token for external callers of POST /api/quick-add (Home Assistant, etc.).
# Leave unset to disable token auth (the endpoint still accepts a logged-in session).
LIST_API_TOKEN=

# Optional
# BODY_SIZE_LIMIT=1M
# LIST_DB_PATH=/data/list.db   # default; the bind mount provides /data
